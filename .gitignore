# Binaries that `go build ./cmd/X` drops in the module root, because it
# writes to the working directory when no -o is given. Three reached the
# repo before this list did: candidates-review in PR-6, and chat-probe and
# summary-judge in PR-8, for 216 MB together (D-255).
#
# One line per command in go/cmd. A new command needs a new line, which
# the test in go/cmd/cmdignore_test.go enforces.
/go/api
/go/api-build
/go/candidates-review
/go/chat-probe
/go/allow
/go/feedback
/go/feedback-harvest
/go/case-check
/go/feedback-triage
/go/users-backfill
/go/deck-gate
/go/eval
/go/bracket-gate
/go/sixty-gate
/go/quality-gate
/go/revise-gate
/go/generate-probe
/go/m5-report
/go/m5-sheet
/go/questions-eval
/go/questions-gate
/go/summary-judge
/go/tune-check
/go/worker

# D-640 kept the feedback harvest out of the repository, and D-642 dropped
# that rule. D-879 writes the harvest under .local/feedback, so the rule of
# .local above covers it. A case of the fix cycle still holds the words of
# the reader (D-642).

# The check tools of docs/tools leave bytecode of the local Python.
__pycache__/
