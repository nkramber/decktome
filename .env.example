# Copy to .env (gitignored, never committed). make dev and make test-smoke source it.
# Provider keys for the LLM role layer (PR-10). Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional per-role overrides: LLM_<ROLE>_<PROVIDER|MODEL|EFFORT>.
# Roles: classify, ask, generate, repair, judge. Defaults: go/internal/llm/roles.json.
# LLM_GENERATE_MODEL=gpt-5.6-sol
