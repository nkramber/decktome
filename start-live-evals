#!/usr/bin/env bash
# Start the live evals (D-1132). scripts/live-evals.sh holds the loop.
# /bin/bash reads the script, and the kernel never runs a script of the
# volume itself. Under launchd, macOS refuses the volume to the children
# of such a script (D-1166).
exec /bin/bash "$(dirname "$0")/scripts/live-evals.sh" "$@"
